# Copie ce fichier vers .env, puis remplace les valeurs. Ne mets jamais .env sur GitHub.

# Projet Supabase « pokewishlist » : bouton Connect, puis Session pooler.
DATABASE_URL=postgresql://postgres.xxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Projet Supabase « pokewishlist-test » : les tests VIDENT cette base.
TEST_DATABASE_URL=postgresql://postgres.yyyyy:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

PORT=3001
# Plusieurs adresses possibles, séparées par des virgules.
CORS_ORIGIN=http://localhost:3000
